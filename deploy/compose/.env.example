# Settings for deploy/compose/compose.yaml. Copy to .env beside it and fill in what you need;
# everything here is optional. README.md says what each one is for.

# The docker socket's group on this machine (`stat -c %g /var/run/docker.sock`), which the launcher
# container is added to. 0 suits Docker Desktop; most Linux engines want the docker group's id.
DOCKER_GID=0

# Where the web UI is published. 127.0.0.1 keeps it on this machine; 0.0.0.0 publishes it to your
# network, which needs TLS in front (README.md, Beyond localhost).
RYPH_UI_BIND=127.0.0.1
RYPH_UI_PORT=3000
# Where previews of agents' dev servers are published, beside the UI (http://<id>.localhost:7490).
RYPH_PREVIEW_PORT=7490
# The address a browser uses. Set it to your https URL behind a reverse proxy.
# RYPH_APP_URL=https://ryph.example.lan

# on: people register, the first with the setup token from the logs. off: one owner.
RYPH_MULTIUSER=on

# GitHub as you: a fine-grained personal access token (README.md, GitHub).
RYPH_GITHUB_TOKEN=

# GitLab as you: a personal access token with api, read_repository and write_repository, on
# gitlab.com or your own instance (README.md, GitLab).
# RYPH_GITLAB_URL=https://gitlab.example.com
# RYPH_GITLAB_MODE=user
# RYPH_GITLAB_TOKEN=

# Radicle with ryph's own node: also set COMPOSE_PROFILES=radicle and a token both sides share,
# made with: openssl rand -hex 32
# COMPOSE_PROFILES=radicle
# RYPH_RADICLE_URL=http://radicle:7470
# RYPH_RADICLE_TOKEN=

# Outbound mail for verification and password-reset links; both or neither.
# RYPH_SMTP_URL=smtp://user:pass@mail.example.com:587
# RYPH_MAIL_FROM=ryph@example.com

# Environment builds and the checks that run on them (README.md, Environments). off: every run
# starts from the agent image and installs its repo's dependencies itself.
# RYPH_ENVIRONMENTS=on
# RYPH_CHECKS=on

# Spend limits, in USD: per run, and a rolling ceiling for the whole deployment.
# RYPH_RUN_MAX_SPEND_USD=5
# RYPH_MODEL_SPEND_CEILING_USD=200

# Which ryph to run: a release (0.1.0), edge (the newest build of main) or sha-<commit>. Every image here
# follows it, the launcher's included: ryph and the launcher refuse to work at different versions.
# RYPH_VARIANT=-radicle runs ryph's image with Radicle's CLI at that same version (README.md,
# Radicle).
# RYPH_VERSION=edge
# RYPH_VARIANT=

# Build from this checkout instead of pulling (README.md, Building from source).
# COMPOSE_FILE=compose.yaml:compose.build.yaml

# The compose project and the docker network runs join. Change both to run a second instance on
# the same engine.
# COMPOSE_PROJECT_NAME=ryph-compose
# RYPH_NETWORK=ryph-compose
