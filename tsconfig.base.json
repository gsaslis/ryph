{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ESNext"
    ],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "types": [
      "bun"
    ]
  },
  "files": [
    "types/web.d.ts",
    "types/text.d.ts"
  ]
}
