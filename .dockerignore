# Allowlist: the build needs the source and dependency manifests, nothing else.
# Anything not listed stays out, so a forgotten entry breaks the build instead
# of silently shipping new files into an image that runs untrusted agent code.
*
!package.json
!bun.lock
!bunfig.toml
# Every member's manifest: bun's install wants each workspace a package names on disk, so every
# image copies all of them and installs only what its own service needs.
!packages/*/package.json
!packages/logger/src/
!packages/sealed/src/
!packages/shared/src/
!packages/tunnel/src/
!packages/process/src/
!packages/service/src/
!packages/db/src/
!packages/runner/src/
!packages/auth/src/
!packages/forge/src/
!packages/launcher/src/
!packages/webhooks/src/
!packages/webhooks/drizzle.config.ts
!packages/webhooks/drizzle/
!packages/webhooks/scripts/
!packages/automations/src/
!packages/automations/drizzle.config.ts
!packages/automations/drizzle/
!packages/automations/scripts/
!packages/orchestrator/src/
!packages/orchestrator/catalogue/
!packages/orchestrator/skills/
!packages/orchestrator/drizzle.config.ts
!packages/orchestrator/drizzle/
!packages/model-proxy/src/
!packages/model-proxy/drizzle.config.ts
!packages/model-proxy/drizzle/
!packages/model-proxy/scripts/
!packages/mcp-gateway/src/
!packages/mcp-gateway/catalogue/
!packages/mcp-gateway/drizzle.config.ts
!packages/mcp-gateway/drizzle/
!packages/mcp-gateway/scripts/
!packages/pi-mcp/package-lock.json
!packages/pi-mcp/index.ts
!packages/pi-mcp/images.ts
!packages/historian/src/
!packages/historian/drizzle.config.ts
!packages/historian/drizzle/
!packages/memory/src/
!packages/memory/scripts/
!packages/memory/drizzle.config.ts
!packages/memory/drizzle/
!packages/web/src/
!packages/previews/src/
!packages/browser/src/
!packages/chat/src/
!packages/chat/scripts/
!packages/chat/drizzle.config.ts
!packages/chat/drizzle/
!packages/radicle/src/
!packages/radicle/scripts/
!packages/radicle/drizzle.config.ts
!packages/radicle/drizzle/
# The `ryph` binary (images/ryph): its CLI, the single-process composition root, and the build
# script that compiles them.
!packages/ryph/src/
!packages/ryph/scripts/
!packages/host/src/
!packages/app/vite.config.ts
!packages/app/tsconfig.json
!packages/app/src/
!packages/app/static/
!images/control-plane/entrypoint.sh
!images/control-plane/sanitizer.sh
!images/model-proxy/entrypoint.sh
!images/mcp-gateway/entrypoint.sh
!images/forge/entrypoint.sh
!images/historian/entrypoint.sh
!images/automations/entrypoint.sh
!images/memory/entrypoint.sh
!images/memory/embeddings/package.json
!images/memory/embeddings/bun.lock
!images/chat/entrypoint.sh
!images/web/entrypoint.sh
!images/previews/entrypoint.sh
!images/browser/entrypoint.sh
!images/radicle/entrypoint.sh
!images/radicle-node/entrypoint.sh
!images/radicle-node/build-radicle.sh
!images/tool-guard/main.ts
!images/egress-proxy/main.ts
!images/run-gate/main.ts
