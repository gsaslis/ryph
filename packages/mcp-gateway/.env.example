# @ryph/mcp-gateway — environment for the STANDALONE composition root (`bun run dev`): the
# process agent containers dial as "the MCP server" (data plane), plus the control listener that
# carries server CRUD, the probe, and the internal credential surface the control plane dials.
# Copy to `.env` (gitignored) and adjust.

# ── Listeners ────────────────────────────────────────────────────────────────────────────────
# The data plane: reachable from the run network.
#RYPH_MCP_GATEWAY_PORT=7430
# The control plane: server CRUD and the internal surface. Never expose this to the run network.
#RYPH_MCP_GATEWAY_CONTROL_PORT=7431

# ── Secrets ──────────────────────────────────────────────────────────────────────────────────
# REQUIRED: the AES-GCM master key sealing MCP credentials (64 hex chars). This package's own —
# not the model-proxy's RYPH_SECRETS_KEY.
#RYPH_MCP_KEY=

# ── Database ─────────────────────────────────────────────────────────────────────────────────
# A ryph database URL: pglite:<path>, pglite:memory:// or postgres://… . Standalone, this is
# the gateway's OWN database (`ryph_mcp`); nothing else connects to it.
#RYPH_DB=pglite:./data/ryph

# ── Addresses ────────────────────────────────────────────────────────────────────────────────
# The data plane AS AN AGENT CONTAINER dials it — a container-network address, not the bind
# address above. Unset, servers can still be managed; only minting is refused, and it says so.
#RYPH_MCP_GATEWAY_URL=http://mcp-gateway:7430
# The shared service credential the control plane presents on /internal/v1/… . Unset, that
# surface is dark.
#RYPH_MCP_GATEWAY_TOKEN=
# The platform's forge server: the forge's tool surface and the credential presented there (the
# forge's RYPH_FORGE_GATEWAY_TOKEN). Both or neither.
#RYPH_FORGE_TOOLS_URL=http://localhost:7412
#RYPH_FORGE_GATEWAY_TOKEN=
# The @ryph/auth origin whose JWKS gates server CRUD — the same one the orchestrator uses.
#RYPH_AUTH_URL=http://orchestrator:7411

# ── Policy ───────────────────────────────────────────────────────────────────────────────────
# Backstop lifetime of a run's virtual token (default 12h). Revocation on conclusion is the
# primary cutoff.
#RYPH_MCP_VIRTUAL_KEY_TTL_MS=43200000
# Every request one run may make through the data plane, across its whole life — denied calls
# included (default 10000). Past it the gateway answers 429 and dials nothing.
#RYPH_MCP_PER_RUN_REQUESTS=10000
# Where the gateway may dial. By default: public https hosts only. Each flag widens that, and is
# logged when set.
#RYPH_MCP_ALLOW_INSECURE=false
#RYPH_MCP_ALLOW_PRIVATE_UPSTREAMS=false

# ── Logging ──────────────────────────────────────────────────────────────────────────────────
# debug / info / warn / error / critical.
#RYPH_LOG_LEVEL=info
# json / text / colorful (default depends on whether stdout is a tty).
#RYPH_LOG_FORMAT=
