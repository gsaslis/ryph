# Copy to .env for `bun run dev`. See src/main.ts for the full contract.

# Where the recipes, fire history, and the mailroom's hooks live.
RYPH_AUTOMATIONS_DB=pglite:./data/automations

# The orchestrator's events door, and the service token it checks: any random string, the same
# value the orchestrator has (`openssl rand -hex 32`).
RYPH_ORCHESTRATOR_URL=http://127.0.0.1:7411
RYPH_AUTOMATIONS_TOKEN=

# User CRUD verifies JWTs against this issuer's JWKS; RYPH_AUTH=off skips it for local dev.
RYPH_AUTH_URL=http://127.0.0.1:7411
# RYPH_AUTH=off

# The chat service, asked which platform a response's chatroom is on (a Telegram room only).
# Unset: no chat, and a response names no chatroom.
# RYPH_CHAT_URL=http://127.0.0.1:7450

RYPH_AUTOMATIONS_PORT=7414
# RYPH_AUTOMATIONS_SWEEP_INTERVAL_MS=2000
# RYPH_AUTOMATIONS_SCHEDULER_INTERVAL_MS=15000
