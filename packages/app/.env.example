# Base URL of the ryph orchestrator (which also serves the auth API).
# Only read server-side — the browser never talks to the orchestrator
# directly; all API traffic goes through the app's same-origin /api proxy.
RYPH_API_URL=http://127.0.0.1:7411

# Behind a reverse proxy or load balancer, the caller's address arrives in a header. Name it,
# or every visitor shares one address — and one anonymous rate-limit budget — upstream.
# XFF_DEPTH counts entries from the right: 1 behind one proxy that appends only the client,
# 2 behind one that appends "<client>, <itself>" (Google's HTTPS load balancer does).
#ADDRESS_HEADER=x-forwarded-for
#XFF_DEPTH=1

# The control plane's RYPH_PROXY_SECRET, sent beside each client address so the control plane
# believes it. Required by a built server; `./dev init` writes the same one here and on the host.
#RYPH_PROXY_SECRET=

# Where the proxy sends the routes a standalone service owns: transcript reads to
# the historian, provider-key management to the model-proxy's CONTROL listener,
# MCP-server management (and a run's tool-call trail) to the mcp-gateway's CONTROL
# listener, the memory manager to the memory service. Each defaults to RYPH_API_URL,
# which is right for the single-process host; set them only when the service actually
# runs on its own.
#RYPH_HISTORY_URL=http://127.0.0.1:7411
#RYPH_MODEL_PROXY_CONTROL_URL=http://127.0.0.1:7421
#RYPH_MCP_GATEWAY_CONTROL_URL=http://127.0.0.1:7431
#RYPH_MEMORY_URL=http://127.0.0.1:7440

# GitHub App coordinates for the repo-connect and account-link flows. Public:
# the browser builds the install URL from the slug, and the OAuth authorize
# URL from the client id (the client secret stays at the forge).
#
# COMMENTED, like every other optional value here. They used to ship set to
# placeholders, so a scaffolded .env claimed an App the forge does not have —
# and the repo-connect flow then built an authorize URL for a client id that
# does not exist. Unset is the honest state, and the app says so when asked.
#PUBLIC_GITHUB_APP_NAME=your-app-slug
#PUBLIC_GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx

# GitLab sign-in: the instance the browser is sent to (the forge's RYPH_GITLAB_URL) and the OAuth
# application's client id (the forge's RYPH_GITLAB_CLIENT_ID). Unset: no GitLab sign-in.
#PUBLIC_GITLAB_URL=https://gitlab.com
#PUBLIC_GITLAB_CLIENT_ID=
