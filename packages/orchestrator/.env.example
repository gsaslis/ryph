# @ryph/orchestrator — environment for the STANDALONE composition root (`bun run dev`),
# the networked deployment where each service is its own process. The default local deployment
# is @ryph/host, which has its own .env.example; every variable here keeps the same name and
# semantics there unless noted.
# Copy to `.env` (gitignored) and adjust.

# ── Listener ─────────────────────────────────────────────────────────────────────────────────
#RYPH_PORT=7411

# ── Database ─────────────────────────────────────────────────────────────────────────────────
# A ryph database URL: pglite:<path> (embedded PostgreSQL on disk), pglite:memory://
# (throwaway — everything is gone on exit) or postgres://… . All three are real PostgreSQL 17.
# Provision the schema first: `bun run db:push` in this package — standalone, the drizzle
# config covers only the orchestrator's own tables.
#RYPH_DB=pglite:./data/ryph

# ── User-surface authentication ──────────────────────────────────────────────────────────────
# The standalone auth service's base URL; tokens are verified against its JWKS. Unset, only
# RYPH_AUTH=off opens the surface.
#RYPH_AUTH_URL=http://localhost:7412
# `off` opens the user surface entirely — local hacking only.
#RYPH_AUTH=off
# Many people sign in by default; `off` narrows a claimed instance to its owner, who must have
# a way in besides a login link (this deployment mints none).
#RYPH_MULTIUSER=off
# Shared with the app, so only the app can name a client address. Required multi-user, unless
# RYPH_AUTH=off.
#RYPH_PROXY_SECRET=
# Outbound mail for verification and password-reset links: an SMTP URL and the From header.
# Both or neither. Unset, every such link is shown to an admin in the UI instead of mailed.
#RYPH_SMTP_URL=smtp://user:password@smtp.example.com:587
#RYPH_MAIL_FROM=ryph <ryph@example.com>

# ── Secrets ──────────────────────────────────────────────────────────────────────────────────
# AES-GCM master key sealing linked GitHub OAuth tokens: 64 hex chars, e.g. from
# `openssl rand -hex 32`. Unset, repo connections are refused. Standalone, the orchestrator
# wires no model access — the model-access knobs belong to @ryph/host.
#RYPH_SECRETS_KEY=

# ── Forge (GitHub boundary) ──────────────────────────────────────────────────────────────────
# The forge is its own process: `bun run --filter '@ryph/forge' dev` (port 7412).
# All three knobs unset: the forge surface is dark, no repo can be connected and no task can
# start.
# The forge as THIS process dials it (permission checks, PR submission, OAuth exchange).
# "noop" wires the recording fake — the whole patch lifecycle with no GitHub anywhere.
#RYPH_FORGE_URL=http://localhost:7412
# The git gateway AS AN AGENT CONTAINER dials it: every run clones through it with a run-scoped
# read-only key and its work leaves as a bundle — host.docker.internal under Desktop. Required
# with an http RYPH_FORGE_URL: the boot refuses a forge without it.
#RYPH_GIT_GATEWAY_URL=http://host.docker.internal:7412
# Shared service credential between this process and the forge — required with either URL
# above; also what mounts the /v1/forge/* surface.
#RYPH_FORGE_TOKEN=
# "on": the gateway serves the forge's tools (RYPH_FORGE_TOOLS_URL on it), so agents may be given
# a forge policy. Needs tool access and the forge pair above. Off, a forge policy is refused.
#RYPH_FORGE_TOOLS=on
# Backstop lifetime of a run's git virtual key.
#RYPH_GIT_KEY_TTL_MS=86400000

# ── Provisioning runs ────────────────────────────────────────────────────────────────────────
# "manual" (the default) launches nothing and prints the env a hand-started runner needs;
# "docker" launches agent containers through a docker launcher (@ryph/launcher), the one process
# that holds the docker socket; this process never runs docker itself. The launcher's networks,
# gate, runtime and builder knobs are its own settings, and set here they refuse the boot.
#RYPH_PROVISIONER=docker
#RYPH_LAUNCHER_URL=http://launcher:7470
#RYPH_LAUNCHER_TOKEN=
# The image every run launches on, whatever its harness kind: it carries them all.
#RYPH_AGENT_IMAGE=ryph-agent:dev
# The browser sidecar a browser agent's run gets; unset, none does.
# docker and kubernetes (1.29+, native sidecars) launch it, each on top of the run's size class;
# a run that cannot get one starts without it. A digest-pinned image that will not pull holds a
# kubernetes run's pod, so push it first. Turning it on for an agent takes agents:policy.
#RYPH_BROWSER_IMAGE=ryph-browser:dev
#RYPH_BROWSER_CPUS=1
#RYPH_BROWSER_MEMORY=1536Mi
# The harness kinds an agent may be created with.
#RYPH_HARNESS_KINDS=pi,echo
# Size classes, name:key=value,…;name2:… with keys cpu, memory, ephemeral-storage, work-volume.
# An admin picks one per repo or workspace; RYPH_RUN_SIZE_DEFAULT (unset: the first) the rest.
#RYPH_RUN_SIZES=standard:cpu=4,memory=8Gi,ephemeral-storage=10Gi
#RYPH_RUN_SIZE_DEFAULT=standard
# Environment builds. Off: every run uses RYPH_AGENT_IMAGE.
#RYPH_ENVIRONMENTS=off
# With the docker provisioner the builder is docker too, and builds run in the docker launcher; no
# registry, the image stays in docker's store. The two images a build is made of are what `bun run
# agent-image` leaves behind, and the launcher needs them set as well. The docker builder's own
# knobs (RYPH_ENV_BUILD_PLATFORM, RYPH_ENV_BUILDKIT_IMAGE, RYPH_ENV_CACHE_DIR, RYPH_ENV_TEMP_DIR)
# are the launcher's settings, and a standalone launcher builds only with RYPH_DOCKER_RUN_NETWORK
# set (packages/launcher/README.md).
#RYPH_ENV_BUILDER=docker
#RYPH_HARNESS_IMAGE=ryph-harness:dev
#RYPH_ENV_BASE_IMAGE=ryph-universal:dev
# The git gateway as a build's clone dials it. The docker builder clones in the launcher, where
# RYPH_GIT_GATEWAY_URL's run-facing address may not resolve, so unset it uses RYPH_FORGE_URL.
#RYPH_ENV_GIT_GATEWAY_URL=
#RYPH_ENV_BUILD_TIMEOUT=60m
#RYPH_ENV_BUILD_CONCURRENCY=2
#RYPH_ENV_REBUILD_INTERVAL=6h
# Incremental builds in a row before the next is cold: each keeps what it rewrote on top of the
# last, so the cap bounds how far an image grows. 0 builds every image cold.
#RYPH_ENV_WARM_CHAIN=4

# Builds in the cluster (packages/orchestrator/docs/environment-builders.md): one Job per build in
# its own namespace, rootless BuildKit under the run's sandbox runtime class, pushing to a registry
# a node can pull from. The API connection is the provisioner's (RYPH_K8S_*). A branch build pushes
# as an identity of its own to a registry of its own, required when the registry is authenticated.
#RYPH_ENV_BUILDER=kubernetes
#RYPH_ENV_REGISTRY=<region>-docker.pkg.dev/<project>/ryph-envs/<cell>
#RYPH_ENV_BRANCH_REGISTRY=<region>-docker.pkg.dev/<project>/ryph-env-branches/<cell>
# gke-metadata (Workload Identity) for a Google registry, else none — the default says which.
#RYPH_ENV_REGISTRY_AUTH=
#RYPH_ENV_BUILD_NAMESPACE=ryph-builds
#RYPH_ENV_BUILD_SERVICE_ACCOUNT=ryph-builder
#RYPH_ENV_BRANCH_BUILD_SERVICE_ACCOUNT=ryph-branch-builder
# Unset: RYPH_K8S_RUNTIME_CLASS, the run's own sandbox. One of the two is required: BuildKit runs
# with seccomp and AppArmor unconfined, so the runtime class is a build's one boundary.
#RYPH_ENV_BUILD_RUNTIME_CLASS=
# on: build with no runtime class, on the node's own kernel. Laptop clusters (kind, k3d) only.
#RYPH_ENV_BUILD_ALLOW_UNSANDBOXED=off
# The build pod's resources; the work volume holds BuildKit's state and the clones.
#RYPH_ENV_BUILD_SIZE=cpu=4,memory=8Gi,ephemeral-storage=10Gi,work-volume=50Gi
#RYPH_ENV_BUILDKIT_IMAGE=moby/buildkit:v0.32.2-rootless@sha256:…
# native is what works under gVisor; override only off gVisor.
#RYPH_ENV_BUILDKIT_SNAPSHOTTER=native

# Builds on Cloud Build instead (packages/orchestrator/docs/environment-builders.md): a private
# worker pool that reaches this deployment only through internal load balancers. The Google token
# comes from the pod's metadata server (Workload Identity), so this runs on GKE, not a laptop.
# The pool, the log buckets, the registries and both service accounts are yours to provision.
#RYPH_ENV_BUILDER=cloud-build
#RYPH_ENV_REGISTRY=<region>-docker.pkg.dev/<project>/ryph-envs/<cell>
#RYPH_ENV_BRANCH_REGISTRY=<region>-docker.pkg.dev/<project>/ryph-env-branches/<cell>
#RYPH_ENV_CLOUD_BUILD_POOL=projects/<project>/locations/<region>/workerPools/<pool>
#RYPH_ENV_CLOUD_BUILD_LOGS=<project>-build-logs
#RYPH_ENV_CLOUD_BUILD_BRANCH_LOGS=<project>-branch-build-logs
#RYPH_ENV_CLOUD_BUILD_SERVICE_ACCOUNT=ryph-builder@<project>.iam.gserviceaccount.com
#RYPH_ENV_CLOUD_BUILD_BRANCH_SERVICE_ACCOUNT=ryph-branch-builder@<project>.iam.gserviceaccount.com
#RYPH_ENV_CLOUD_BUILD_DISK=500G
#RYPH_ENV_BUILDKIT_IMAGE=<registry>/buildkit:v0.32.2@sha256:…
# The git gateway and the egress proxy as a worker dials them: the cell's internal load balancers.
#RYPH_ENV_GIT_GATEWAY_URL=http://<gateway lb ip>:7412
#RYPH_ENV_EGRESS_PROXY_URL=http://<egress lb ip>:7460
# The docker network runs go on (RYPH_DOCKER_NETWORK) is the launcher's setting, refused here.
# The control plane's address as runners dial it: the run gate's, where the launcher confines runs.
#RYPH_PUBLIC_URL=http://ryph-gate-ryph:7411

# ── Liveness timing ──────────────────────────────────────────────────────────────────────────
# Silence longer than this marks a run lost.
#RYPH_HEARTBEAT_TIMEOUT_MS=60000
# How long a cancelled run may keep running before the reaper's kill.
#RYPH_CANCEL_GRACE_MS=120000
# Reaper sweep cadence.
#RYPH_REAPER_INTERVAL_MS=10000
# GitHub or GitLab user mode (no webhooks): how long after an answer an open pull or merge
# request is read again for a merge or close, and how many the submit sweep reads per tick (0
# switches the poll off). One whose patches closed is read every ten minutes for a week, whatever
# the interval. GitLab bot mode polls too, every ten minutes, for projects whose merge request
# events have not been heard; 0 per tick switches that fallback off as well.
#RYPH_MERGE_POLL_INTERVAL_MS=60000
#RYPH_MERGE_POLL_PER_TICK=2

# ── Run limits ───────────────────────────────────────────────────────────────────────────────
# The ceiling every run is under; an agent's policy and a task's override lower it, never raise
# it. 0 is no cap. See docs/development.md.
#RYPH_RUN_MAX_WALL_CLOCK_MS=43200000
#RYPH_RUN_MAX_SPEND_USD=
#RYPH_RUN_MAX_CALLS_IN_FLIGHT=8
# How many runs may be live at once across the deployment; unset is no cap.
#RYPH_RUN_CONCURRENCY=
# How many times one run may be issued a model credential.
#RYPH_RUN_MAX_CREDENTIALS=3

# ── Logging ──────────────────────────────────────────────────────────────────────────────────
# debug / info / warn / error / critical.
#RYPH_LOG_LEVEL=info
# json / text / colorful (default depends on whether stdout is a tty).
#RYPH_LOG_FORMAT=
